# 蓝湖 MCP 服务器配置示例
# 复制此文件为 .env 并填入你的配置值
# ⚠️ 注意：不要将 .env 文件提交到 git！

# ==============================================
# 必需配置
# ==============================================

# 蓝湖 Cookie（必需）
# 获取方法：登录蓝湖网页版，打开浏览器开发者工具，从请求头中复制 Cookie
LANHU_COOKIE="your_lanhu_cookie_here"

# ==============================================
# 可选配置
# ==============================================

# 数据存储目录
# 默认值：./data
DATA_DIR="./data"

# 服务器主机地址
# 默认值：0.0.0.0（监听所有网络接口）
# 如果只需本地访问，使用 127.0.0.1
SERVER_HOST="0.0.0.0"

# 服务器端口
# 默认值：8000
SERVER_PORT=8000


# ==============================================
# 高级配置
# ==============================================

# 日志级别
# 可选值：DEBUG, INFO, WARNING, ERROR, CRITICAL
# 默认值：INFO
LOG_LEVEL="INFO"

# 日志目录
# 默认值：./logs
LOG_DIR="./logs"

# HTTP 请求超时时间（秒）
# 默认值：30
HTTP_TIMEOUT=30


# ==============================================
# 开发配置
# ==============================================

# 调试模式
# 设为 "true" 启用调试模式
# 默认值：false
DEBUG="false"

# 启用热重载
# 设为 "true" 在开发时启用热重载
# 默认值：false
HOT_RELOAD="false"

# ==============================================
# 使用说明
# ==============================================
#
# 1. Cookie 安全：
#    - 妥善保管你的 LANHU_COOKIE
#    - 不要将 .env 文件提交到 git
#    - 定期更换 Cookie
#
# 2. 性能调优：
#    - 网络较慢时增加 HTTP_TIMEOUT
#
# 4. Docker 部署：
#    - 这些环境变量可通过 docker run -e 传递
#    - 或使用 docker-compose.yml 的 environment 配置
#
